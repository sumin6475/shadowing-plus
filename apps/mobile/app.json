{
  "expo": {
    "name": "Shadowing+",
    "slug": "shadowing-plus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shadowingplus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.shadowingplus.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf9f4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Shadowing+ uses the microphone to hear your speaking practice.",
          "speechRecognitionPermission": "Shadowing+ turns your spoken practice into text, on your device, so you can review what you said."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Shadowing+ shows a front-camera mirror while you speak, so you can practice looking up. Nothing is recorded or uploaded.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be9140e7-3966-4c25-b2fb-ec8eb2db4020"
      }
    }
  }
}
