{
  "$meta": {
    "name": "Shadowing Plus — Cobalt Editorial",
    "version": "1.0.0",
    "extractedFrom": ["web/src/app/home.css", "web/src/app/landing.css"],
    "extractedOn": "2026-07-20",
    "note": "Source of truth for all design values. Colors are authored in OKLCH (matching the codebase); hex is an approximate fallback for tools that need it. The legacy orange (#e05d38) system in globals.css is NOT part of this and is treated as deprecated starter code.",
    "colorMode": "OKLCH is canonical; prefer it in code."
  },

  "color": {
    "light": {
      "bg":            { "oklch": "oklch(0.985 0.004 70)", "hex": "#fbf9f4", "use": "Page background. Warm paper, never pure white." },
      "bg-elev":       { "oklch": "oklch(0.995 0.003 70)", "hex": "#fdfcf9", "use": "Elevated surface (sidebar, sticky bars)." },
      "surface":       { "oklch": "oklch(1 0 0)",          "hex": "#ffffff", "use": "Cards, panels sitting on bg." },
      "surface-2":     { "oklch": "oklch(0.975 0.004 70)", "hex": "#f6f4ef", "use": "Recessed / secondary surface, input wells." },
      "hairline":      { "oklch": "oklch(0.91 0.006 70)",  "hex": "#e6e2da", "use": "Default 1px borders and dividers." },
      "hairline-soft": { "oklch": "oklch(0.945 0.005 70)", "hex": "#efece5", "use": "Softer internal dividers." },
      "text":          { "oklch": "oklch(0.24 0.012 60)",  "hex": "#2b2620", "use": "Primary text, headlines." },
      "text-2":        { "oklch": "oklch(0.42 0.011 60)",  "hex": "#524b41", "use": "Body / secondary text." },
      "text-3":        { "oklch": "oklch(0.58 0.010 60)",  "hex": "#847c70", "use": "Tertiary / captions, meta." },
      "text-4":        { "oklch": "oklch(0.72 0.008 70)",  "hex": "#aca596", "use": "Quietest text, timestamps, placeholder. Never body copy." }
    },
    "dark": {
      "bg":            { "oklch": "oklch(0.16 0.006 65)",  "hex": "#181613" },
      "bg-elev":       { "oklch": "oklch(0.185 0.006 65)", "hex": "#1e1c18" },
      "surface":       { "oklch": "oklch(0.215 0.007 65)", "hex": "#26231f" },
      "surface-2":     { "oklch": "oklch(0.245 0.007 65)", "hex": "#2c2924" },
      "hairline":      { "oklch": "oklch(0.295 0.008 65)", "hex": "#38342e" },
      "hairline-soft": { "oklch": "oklch(0.255 0.007 65)", "hex": "#2f2c27" },
      "text":          { "oklch": "oklch(0.96 0.005 70)",  "hex": "#f5f3ef" },
      "text-2":        { "oklch": "oklch(0.78 0.008 70)",  "hex": "#c2bcb1" },
      "text-3":        { "oklch": "oklch(0.62 0.008 70)",  "hex": "#948d82" },
      "text-4":        { "oklch": "oklch(0.46 0.008 70)",  "hex": "#6b655c" }
    },
    "accent": {
      "$note": "Cobalt #3B6EE1 — the single brand color. One accent, used deliberately. Do not introduce a second hue as decoration.",
      "light": {
        "accent":      { "oklch": "oklch(0.58 0.165 258)",  "hex": "#3b6ee1", "use": "Primary buttons, active nav, brand mark, key links." },
        "accent-hover":{ "oklch": "oklch(0.52 0.165 258)",  "hex": "#2f5cc8", "use": "Hover/pressed state of accent." },
        "accent-soft": { "oklch": "oklch(0.955 0.0264 258)","hex": "#e8eefc", "use": "Tinted background for active chips, selected rows." },
        "accent-text": { "oklch": "oklch(0.48 0.165 258)",  "hex": "#2a52b8", "use": "Accent-colored text on soft/white backgrounds (AA-safe)." }
      },
      "dark": {
        "accent":      { "oklch": "oklch(0.70 0.16 258)", "hex": "#6d97f0" },
        "accent-hover":{ "oklch": "oklch(0.76 0.16 258)", "hex": "#89abf4" },
        "accent-soft": { "oklch": "oklch(0.32 0.06 258)", "hex": "#26314d" },
        "accent-text": { "oklch": "oklch(0.78 0.16 258)", "hex": "#93b1f5" }
      }
    },
    "status": {
      "$note": "Status colors are functional only (chips, toasts) — never used as brand accent.",
      "danger":      { "oklch": "oklch(0.58 0.18 25)",  "hex": "#d1503c", "use": "Errors, destructive actions." },
      "danger-soft": { "oklch": "oklch(0.95 0.04 25)",  "hex": "#fbe7e2", "use": "Danger chip background." },
      "success":     { "oklch": "oklch(0.62 0.13 155)", "hex": "#3f9d6a", "use": "Done / ready states." },
      "success-soft":{ "oklch": "oklch(0.95 0.04 155)", "hex": "#e2f4e9", "use": "Success chip background." },
      "moss":        { "oklch": "oklch(0.55 0.10 155)", "hex": "#4f8a63", "use": "Landing secondary accent (calm green). Marketing surface only." },
      "moss-soft":   { "oklch": "oklch(0.955 0.035 155)","hex": "#e7f3ec", "use": "Moss chip background (marketing)." }
    }
  },

  "font": {
    "sans":  { "stack": "\"Pretendard Variable\", Pretendard, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", \"Apple SD Gothic Neo\", \"Malgun Gothic\", sans-serif", "cssVar": "--font-pretendard", "use": "UI + Korean body. Default for everything except display headlines." },
    "serif": { "stack": "\"Instrument Serif\", \"Iowan Old Style\", \"Apple Garamond\", Baskerville, \"Times New Roman\", serif", "cssVar": "--font-instrument-serif", "weight": 400, "use": "Editorial display headlines and the brand wordmark ONLY. Always weight 400. Never for body or UI labels." },
    "mono":  { "stack": "\"JetBrains Mono\", \"SFMono-Regular\", ui-monospace, Menlo, Consolas, monospace", "cssVar": "--font-mono", "use": "Kickers, durations, counts, code, technical meta." }
  },

  "type": {
    "$note": "Real values pulled from home.css/landing.css. Body base is 15px (app) / 16px (marketing). Global letter-spacing -0.005em; serif headlines tighten to -0.015em.",
    "scale": {
      "display-hero":  { "size": "clamp(52px, 8vw, 104px)", "font": "serif", "weight": 400, "lineHeight": 1.02, "letterSpacing": "-0.015em", "use": "Landing hero H1 only." },
      "display-lg":    { "size": "clamp(38px, 5vw, 60px)",  "font": "serif", "weight": 400, "lineHeight": 1.05, "letterSpacing": "-0.015em", "use": "Marketing section headers." },
      "display":       { "size": "clamp(32px, 4vw, 46px)",  "font": "serif", "weight": 400, "lineHeight": 1.05, "letterSpacing": "-0.015em", "use": "Feature headlines." },
      "h1":            { "size": "38px", "font": "serif", "weight": 400, "lineHeight": 1.05, "letterSpacing": "-0.015em", "use": "In-app page title (editorial)." },
      "h2":            { "size": "30px", "font": "serif", "weight": 400, "lineHeight": 1.1,  "letterSpacing": "-0.015em", "use": "In-app section title." },
      "title":         { "size": "24px", "font": "serif", "weight": 400, "lineHeight": 1.15, "letterSpacing": "-0.01em",  "use": "Card / list-group serif title." },
      "lede":          { "size": "19px", "font": "sans",  "weight": 400, "lineHeight": 1.55, "use": "Intro paragraph under a headline." },
      "body-lg":       { "size": "17px", "font": "sans",  "weight": 400, "lineHeight": 1.6,  "use": "Feature body copy." },
      "body":          { "size": "15px", "font": "sans",  "weight": 400, "lineHeight": 1.55, "use": "Default app body / row text." },
      "body-sm":       { "size": "13.5px", "font": "sans", "weight": 400, "lineHeight": 1.5, "use": "Compact rows, secondary lines." },
      "label":         { "size": "13px", "font": "sans",  "weight": 500, "use": "Buttons, nav, form labels." },
      "caption":       { "size": "12px", "font": "sans",  "weight": 400, "use": "Meta, captions." },
      "kicker":        { "size": "12px", "font": "mono",  "weight": 600, "letterSpacing": "0.16em", "transform": "uppercase", "use": "Eyebrow above headlines. Mono, wide-tracked." },
      "overline":      { "size": "11px", "font": "sans",  "weight": 600, "letterSpacing": "0.08em", "transform": "uppercase", "use": "Nav section headers, small all-caps labels. Keep >=11px, weight 600 (guardrail)." },
      "mono-meta":     { "size": "11px", "font": "mono",  "weight": 400, "use": "Durations, counts, timestamps." }
    }
  },

  "radius": {
    "sm":   "8px",
    "md":   "12px",
    "lg":   "16px",
    "xl":   "24px",
    "pill": "999px",
    "$note": "Default is md (12px). Pill for chips, tags, and buttons. xl only for large marketing floating cards."
  },

  "shadow": {
    "$note": "Layered, low-opacity, warm-black shadows with a 1px top inset highlight — this is the signature 'lift'. Never use a flat single-value drop shadow.",
    "card":       "0 1px 0 oklch(1 0 0 / 0.6) inset, 0 1px 1.5px oklch(0 0 0 / 0.04), 0 4px 14px -8px oklch(0 0 0 / 0.10)",
    "card-hover": "0 1px 0 oklch(1 0 0 / 0.6) inset, 0 2px 4px oklch(0 0 0 / 0.05), 0 12px 28px -14px oklch(0 0 0 / 0.18)",
    "float":      "0 1px 0 oklch(1 0 0 / 0.7) inset, 0 40px 90px -34px oklch(0 0 0 / 0.32), 0 12px 30px -16px oklch(0 0 0 / 0.18)",
    "dark": {
      "card":       "0 1px 0 oklch(1 0 0 / 0.04) inset, 0 1px 2px oklch(0 0 0 / 0.30), 0 6px 18px -10px oklch(0 0 0 / 0.45)",
      "card-hover": "0 1px 0 oklch(1 0 0 / 0.05) inset, 0 2px 6px oklch(0 0 0 / 0.35), 0 14px 32px -16px oklch(0 0 0 / 0.55)"
    }
  },

  "space": {
    "$note": "8px-based rhythm observed in the code. Row padding 14px/20px, sidebar padding 18-22px, section gaps generous.",
    "row-gap": "8px",
    "row-pad-y": "14px",
    "row-pad-x": "20px",
    "row-h": "64px",
    "sidebar-w": "260px",
    "content-w": "920px",
    "maxw-marketing": "1120px",
    "scale": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" }
  },

  "misc": {
    "baseFontSize": { "app": "15px", "marketing": "16px" },
    "globalLetterSpacing": "-0.005em",
    "fontFeatureSettings": "\"ss01\", \"cv11\"",
    "antialias": true,
    "themeColorMeta": "#fbf9f4",
    "transition": "all 0.15s"
  }
}
