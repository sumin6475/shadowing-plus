# Shadowing+ mobile (Expo) — public env template.
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Only EXPO_PUBLIC_* vars are exposed to the client bundle — this app holds NO
# secrets. It uses the Supabase *anon* key (RLS-scoped) and calls the deployed
# web API for anything that needs a server secret (R2 presign, ASR, etc.).
# Never put SUPABASE_SERVICE_KEY or any R2/OpenAI/ElevenLabs key here.

# Same Supabase project as the web app (web/.env NEXT_PUBLIC_SUPABASE_*).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Base URL of the deployed web API the app calls with a Bearer token.
# Production: https://shadowing-plus.vercel.app
# Local dev against the web app on the same Wi-Fi: http://<your-mac-LAN-ip>:3000
#   (NOT localhost — the phone can't reach the Mac's localhost over Expo Go).
EXPO_PUBLIC_API_BASE_URL=https://shadowing-plus.vercel.app

# Expo SDK 57 installs expo/fetch as the native global fetch by default. The
# React Native transport is more reliable for this app's Supabase Edge Function
# requests on iOS (see eas.json, which pins this for every EAS build profile).
EXPO_PUBLIC_USE_RN_FETCH=1
